COMPOSE_PROJECT_NAME=rhetorica

POSTGRES_DB=rhetorica
POSTGRES_USER=rhetorica
POSTGRES_PASSWORD=rhetorica
POSTGRES_PORT=5432

REDIS_PORT=6379
QDRANT_PORT=6333

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=rhetorica-dev

API_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+psycopg://rhetorica:rhetorica@postgres:5432/rhetorica
AUTH_ENABLED=true
AUTH_DEFAULT_WORKSPACE_ID=default
AUTH_JWT_SECRET=change-me-rhetorica-dev-jwt-secret-0000000000000000
AUTH_LOCAL_ADMIN_LOGIN=admin
AUTH_LOCAL_ADMIN_PASSWORD=admin
AUTH_LOCAL_ADMIN_DISPLAY_NAME=Platform Admin
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_LOGIN_SECRET=change-me-rhetorica-dev-bootstrap-secret-000000000000
LOG_LEVEL=DEBUG
LOG_LLM_CONTENT=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION_NAME=rag_insights
RAG_VECTOR_SIZE=384
RAG_DISTANCE=cosine
RAG_PREFER_GRPC=false
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CONFIDENCE_THRESHOLD=0.7
RAG_MERGE_SIMILARITY_THRESHOLD=0.9
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=rhetorica-dev
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=change-me
